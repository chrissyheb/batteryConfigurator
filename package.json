{
  "name": "battery-configurator-two-spec-files",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:exe": "npm run build && npx rimraf server/dist && npx cpy \"dist/**\" server/dist && npx mkdirp release && cd server && echo 'Building .exe ...' && go build --ldflags \"-s -w\" -o ../release/batteryConfigurator.exe ."
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "baseline-browser-mapping": "^2.9.19",
    "cpy-cli": "^6.0.0",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.6.2",
    "vite": "^7.1.7"
  }
}
